@{
    ViewBag.Title = "TalentRecord";
    // 規劃進程、待發展能力：只有部門主管 (Session["leader"]) 可編輯
    // 自我發展規劃：員工本人或部門主管可編輯；後端 Talent/SaveResponse 本人只會更新這一欄
    // 「儲存」按鈕：部門主管，或本人頁面才顯示
    // 能看哪位員工由後端 Talent/Get 決定（非部門主管一律只回傳自己）
    bool canEdit = Session["leader"] is true;
    string selfEmpno = TEEmployee.Models.Permissions.NormalizeEmpno(TEEmployee.Models.Permissions.CurrentEmpno(Session));
}

<div ng-controller="TalentRecordCtrl" class="tal-page" ng-init="selfEmpno = '@HttpUtility.JavaScriptStringEncode(selfEmpno)'">

    @* ---------- 個人概覽 ---------- *@
    <section class="tal-hero">
        <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
        <div class="tal-profile three">
            <div class="avatar">
                <img ng-src="Content/CV/{{user.empno}}.jpg" onerror="this.onerror=null;this.src='Content/CV/0000.jpg'" alt="{{user.name}}">
            </div>
            <div>
                <div class="tal-eyebrow"><i class="bi bi-person-vcard"></i> 人才培育資料庫</div>
                <h2>{{user.name}} <small style="font-size:1rem;opacity:.8;font-weight:600">{{user.empno}}</small></h2>
                <div class="tal-stats">
                    <div class="tal-stat"><small>年齡</small><b>{{user.age || '—'}}</b></div>
                    <div class="tal-stat"><small>工作年資</small><b>{{user.workYears || '—'}}</b></div>
                    <div class="tal-stat"><small>公司年資</small><b>{{user.companyYears || '—'}}</b></div>
                </div>
            </div>
            <div class="tal-glass">
                <div class="tal-eyebrow"><i class="bi bi-ladder"></i> 職位經歷</div>
                <ul class="tal-timeline">
                    <li ng-repeat="seniority in user.seniority track by $index" ng-if="seniority">{{seniority}}</li>
                </ul>
            </div>
        </div>
    </section>

    @* ---------- 分頁 ---------- *@
    <ul class="nav tal-tabs" id="pills-tab" role="tablist">
        <li role="presentation">
            <a class="active" id="pills-home-tab" data-toggle="pill" href="#pills-home" role="tab" aria-controls="pills-home" aria-selected="true" title="學校、近五年考績、能力檢視、自我發展規劃">
                <i class="bi bi-person-lines-fill"></i> 基本資料
            </a>
        </li>
        <li role="presentation">
            <a id="pills-profile-tab" data-toggle="pill" href="#pills-profile" role="tab" aria-controls="pills-profile" aria-selected="false" title="職位經歷、專案經歷">
                <i class="bi bi-briefcase"></i> 專案經歷
            </a>
        </li>
        <li role="presentation">
            <a id="pills-contact-tab" data-toggle="pill" href="#pills-contact" role="tab" aria-controls="pills-contact" aria-selected="false" title="規劃進程、專業證照、測評資料、待發展能力">
                <i class="bi bi-signpost-split"></i> 未來規劃
            </a>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">

        @* ======================== 基本資料 ======================== *@
        <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-indigo"><i class="bi bi-mortarboard"></i></span>學歷</h5>
                </div>
                <table class="tal-table">
                    <thead>
                        <tr><th style="width:20%">學歷</th><th>學校</th><th>科系</th></tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="educational in user.educational track by $index" ng-if="educational">
                            <td><span class="tal-tag indigo">{{educational.split('　')[0]}}</span></td>
                            <td>{{educational.split('　')[1]}}</td>
                            <td>{{educational.split('　')[2]}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-amber"><i class="bi bi-graph-up-arrow"></i></span>近五年考績</h5>
                    <a class="tal-btn tal-btn-light tal-btn-sm" data-toggle="collapse" href="#collapseOne" role="button" aria-expanded="false" aria-controls="collapseOne"><i class="bi bi-eye"></i> 顯示 / 隱藏</a>
                </div>
                <div id="collapseOne" class="collapse">
                    <div class="tal-perf">
                        <div>{{user.performance[0]}}</div>
                        <div>{{user.performance[1]}}</div>
                        <div>{{user.performance[2]}}</div>
                        <div>{{user.performance[3]}}</div>
                        <div>{{user.performance[4]}}</div>
                    </div>
                </div>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-teal"><i class="bi bi-stars"></i></span>能力檢視</h5>
                </div>
                <div class="tal-skill-grid">
                    <div class="tal-skill-col">
                        <h6><i class="bi bi-gear-wide-connected text-primary"></i> 領域技能</h6>
                        <div class="tal-tags">
                            <span class="tal-tag indigo" ng-repeat="domainSkill in user.domainSkill track by $index" ng-if="domainSkill">{{domainSkill}}</span>
                        </div>
                    </div>
                    <div class="tal-skill-col">
                        <h6><i class="bi bi-bullseye text-success"></i> 核心技能</h6>
                        <div class="tal-tags">
                            <span class="tal-tag teal" ng-repeat="coreSkill in user.coreSkill track by $index" ng-if="coreSkill">{{coreSkill}}</span>
                        </div>
                    </div>
                    <div class="tal-skill-col">
                        <h6><i class="bi bi-people text-warning"></i> 管理能力</h6>
                        <div class="tal-tags">
                            <span class="tal-tag amber" ng-repeat="manageSkill in user.manageSkill track by $index" ng-if="manageSkill">{{manageSkill}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-rose"><i class="bi bi-pencil-square"></i></span>自我發展規劃</h5>
                    <span class="tal-badge edit" ng-if="isSelf()"><i class="bi bi-pencil"></i> 由員工自己編輯</span>
                    <span class="tal-badge" ng-if="!isSelf()"><i class="bi bi-person"></i> 由員工自己編輯</span>
                </div>
                @if (canEdit)
                {
                    <textarea class="tal-textarea" ng-model="user.future" name="SaveResponse" rows="4" placeholder="寫下你未來想發展的方向、想學的技能…">{{user.future}}</textarea>
                }
                else
                {
                    <textarea class="tal-textarea" ng-model="user.future" name="SaveResponse" rows="4" ng-readonly="!isSelf()" placeholder="寫下你未來想發展的方向、想學的技能…">{{user.future}}</textarea>
                }
            </div>
        </div>

        @* ======================== 專案經歷 ======================== *@
        <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
            <div class="row">
                <div class="col-lg-5">
                    <div class="tal-card">
                        <div class="tal-card-head">
                            <h5 class="tal-card-title"><span class="dot g-indigo"><i class="bi bi-ladder"></i></span>職位經歷</h5>
                        </div>
                        <ul class="tal-timeline">
                            <li ng-repeat="experience in user.experience track by $index" ng-if="experience">{{experience}}</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="tal-card">
                        <div class="tal-card-head">
                            <h5 class="tal-card-title"><span class="dot g-teal"><i class="bi bi-kanban"></i></span>專案經歷</h5>
                        </div>
                        <ul class="tal-timeline teal">
                            <li ng-repeat="project in user.project track by $index" ng-if="project">{{project}}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @* ======================== 未來規劃 ======================== *@
        <div class="tab-pane fade" id="pills-contact" role="tabpanel" aria-labelledby="pills-contact-tab">

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-indigo"><i class="bi bi-signpost-split"></i></span>規劃進程</h5>
                    @if (canEdit)
                    {
                        <span class="tal-badge edit"><i class="bi bi-pencil"></i> 可編輯</span>
                    }
                    else
                    {
                        <span class="tal-badge"><i class="bi bi-lock"></i> 唯讀</span>
                    }
                </div>
                <div class="tal-plan">
                    <div class="lbl">年份</div>
                    <div ng-if="$index < 3" ng-repeat="item in planning track by $index">
                        @if (canEdit)
                        {
                            <input class="tal-input" ng-model="item.plan" name="SaveResponse">
                        }
                        else
                        {
                            <input class="tal-input" ng-model="item.plan" readonly>
                        }
                    </div>
                    <div class="lbl">職位 / 職級</div>
                    <div ng-if="$index >= 3" ng-repeat="item in planning track by $index">
                        @if (canEdit)
                        {
                            <input class="tal-input" ng-model="item.plan" name="SaveResponse">
                        }
                        else
                        {
                            <input class="tal-input" ng-model="item.plan" readonly>
                        }
                    </div>
                </div>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-amber"><i class="bi bi-patch-check"></i></span>專業證照</h5>
                </div>
                <div class="tal-tags">
                    <span class="tal-tag amber" ng-repeat="license in user.license track by $index" ng-if="license"><i class="bi bi-award"></i> {{license}}</span>
                </div>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-teal"><i class="bi bi-file-earmark-pdf"></i></span>測評資料</h5>
                    <span class="tal-note"><i class="bi bi-info-circle"></i> 檔案限定 .pdf，大小不超過 20MB</span>
                </div>
                <div class="tal-toolbar" style="margin-top:0">
                    <div style="flex:0 0 160px">
                        <label class="tal-label" for="SelectYear">年份</label>
                        <select class="tal-select" id="SelectYear" name="SelectYear" ng-model="selectedYear" ng-change="FilterDataByYear(selectedYear)" aria-label="Select the Year">
                            <option ng-repeat="year in years" value="{{year}}">{{year}}</option>
                        </select>
                    </div>
                    <div class="grow">
                        <label class="tal-label" for="importDDIPDFFile">上傳測評 PDF</label>
                        <form id="formElem">
                            <input type="file" id="filepicker" name="file" accept=".pdf" hidden>
                        </form>
                        <input class="tal-input" type="file" accept=".pdf" name="importDDIPDFFile" id="importDDIPDFFile" />
                    </div>
                    <button class="tal-btn tal-btn-primary" id="btnDDIPDFUpload" type="button" ng-click="UploadPDF()"><i class="bi bi-cloud-arrow-up"></i> 上傳</button>
                </div>
                <div class="tal-pdf" ng-show="Show == 1">
                    <iframe id="framePDF" src="" style="width:100%;min-height:800px;border:0;display:block" type="application/pdf"></iframe>
                </div>
                <div class="tal-empty" ng-show="Show != 1" style="padding:26px">
                    <i class="bi bi-file-earmark-pdf"></i>
                    此年份尚未上傳測評資料
                </div>
            </div>

            <div class="tal-card">
                <div class="tal-card-head">
                    <h5 class="tal-card-title"><span class="dot g-rose"><i class="bi bi-lightning-charge"></i></span>待發展能力</h5>
                    @if (canEdit)
                    {
                        <span class="tal-badge edit"><i class="bi bi-pencil"></i> 可編輯</span>
                    }
                    else
                    {
                        <span class="tal-badge"><i class="bi bi-lock"></i> 唯讀</span>
                    }
                </div>
                @if (canEdit)
                {
                    <textarea class="tal-textarea" ng-model="user.developed" name="SaveResponse" rows="4">{{user.developed}}</textarea>
                }
                else
                {
                    <textarea class="tal-textarea" ng-model="user.developed" rows="4" readonly>{{user.developed}}</textarea>
                }
            </div>
        </div>
    </div>

    @* ---------- 固定在下方的操作列 ---------- *@
    <div class="tal-actionbar">
        <button type="button" class="tal-btn tal-btn-light" ng-click="ToTalent()"><i class="bi bi-arrow-left"></i> 返回</button>
        @if (canEdit)
        {
            <button type="button" class="tal-btn tal-btn-primary" ng-click="SaveResponse(user, planning)"><i class="bi bi-floppy"></i> 儲存</button>
        }
        else
        {
            @* 非部門主管：只有本人頁面可儲存 (僅自我發展規劃) *@
            <button type="button" class="tal-btn tal-btn-primary" ng-if="isSelf()" ng-click="SaveResponse(user, planning)"><i class="bi bi-floppy"></i> 儲存</button>
        }
    </div>

</div>

@section Scripts {
    <script src="@TEEmployee.Models.HtmlHelperExtensions.Versioned(Url, "~/Scripts/WebApp/Talent/TalentRecordCtrl.js")"></script>
}
