@{
    ViewBag.Title = "TalentSuccessExample";
}

<div ng-controller="TalentSuccessExampleCtrl" class="tal-page">

    <section class="tal-hero compact">
        <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
        <div class="tal-hero-row">
            <div>
                <div class="tal-eyebrow"><i class="bi bi-trophy"></i> 人才培育資料庫</div>
                <h2>成功典範</h2>
                <p class="sub">看看各職位的養成路徑，找到值得學習的方向。</p>
            </div>
            <a class="tal-btn tal-btn-glass" href="Talent#!/TalentOption" role="button"><i class="bi bi-arrow-left"></i> 返回</a>
        </div>
    </section>

    <ul class="nav tal-tabs" id="pills-tab" role="tablist">
        <li role="presentation">
            <a class="active" id="pills-technical-manager-tab" data-toggle="pill" href="#pills-technical-manager" role="tab" aria-controls="pills-technical-manager" aria-selected="true">
                <i class="bi bi-cpu"></i> 技術經理
            </a>
        </li>
        <li role="presentation">
            <a id="pills-project-manager-tab" data-toggle="pill" href="#pills-project-manager" role="tab" aria-controls="pills-project-manager" aria-selected="false">
                <i class="bi bi-kanban"></i> 計畫經理
            </a>
        </li>
        <li role="presentation">
            <a id="pills-team-leader-tab" data-toggle="pill" href="#pills-team-leader" role="tab" aria-controls="pills-team-leader" aria-selected="false">
                <i class="bi bi-people"></i> 組長
            </a>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-technical-manager" role="tabpanel" aria-labelledby="pills-technical-manager-tab">
            <div class="tal-card tal-example text-center">
                <img src="~/Content/SuccessExample/技術經理.png" alt="技術經理成功典範">
            </div>
        </div>
        <div class="tab-pane fade" id="pills-project-manager" role="tabpanel" aria-labelledby="pills-project-manager-tab">
            <div class="tal-card tal-example text-center">
                <img src="~/Content/SuccessExample/計畫經理.png" alt="計畫經理成功典範">
            </div>
        </div>
        <div class="tab-pane fade" id="pills-team-leader" role="tabpanel" aria-labelledby="pills-team-leader-tab">
            <div class="tal-card tal-example text-center">
                <img src="~/Content/SuccessExample/組長.png" alt="組長成功典範">
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="@TEEmployee.Models.HtmlHelperExtensions.Versioned(Url, "~/Scripts/WebApp/Talent/TalentSuccessExampleCtrl.js")"></script>
}
