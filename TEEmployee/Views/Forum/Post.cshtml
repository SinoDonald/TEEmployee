    </section>


    <!-- 點圖放大 -->
    <div class="forum-viewer" ng-if="viewer" ng-click="closeImage()">
        <button type="button" class="viewer-btn viewer-close" title="關閉 (Esc)" ng-click="closeImage()">&times;</button>
        <button type="button" class="viewer-btn viewer-prev" title="上一張 (←)" ng-if="viewer.list.length > 1" ng-click="stepImage(-1, $event)">&lsaquo;</button>
        <img ng-src="{{imgUrl(viewer.list[viewer.index], false)}}" alt="附圖" ng-click="$event.stopPropagation()" />
        <button type="button" class="viewer-btn viewer-next" title="下一張 (→)" ng-if="viewer.list.length > 1" ng-click="stepImage(1, $event)">&rsaquo;</button>
        <div class="viewer-footer" ng-click="$event.stopPropagation()">
            <span ng-if="viewer.list.length > 1" ng-bind="(viewer.index + 1) + ' / ' + viewer.list.length"></span>
            <a ng-href="{{imgUrl(viewer.list[viewer.index], false)}}" target="_blank">開新分頁看原圖</a>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">回覆貼文</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label for="exampleFormControlTextarea1">回覆內容</label>
                            <textarea ng-model="modal.content" class="form-control" id="exampleFormControlTextarea1" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label>附加圖片 <small class="text-muted">（選填，最多 5 張，JPG / PNG / GIF，單張 8 MB 以內）</small></label>
                            <div id="forumDropZone" class="forum-dropzone">
                                <span class="material-icons" style="vertical-align: middle">add_photo_alternate</span>
                                將圖片拖曳到這裡，或在此視窗按 <kbd>Ctrl</kbd> + <kbd>V</kbd> 貼上截圖
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('forumImageInput').click()">選擇圖片</button>
                                </div>
                                <input type="file" id="forumImageInput" accept="image/jpeg,image/png,image/gif" multiple hidden />
                            </div>
                            <div class="forum-preview" ng-if="picker.items.length">
                                <div class="forum-preview-item" ng-repeat="img in picker.items">
                                    <img ng-src="{{img.url}}" alt="預覽" />
                                    <button type="button" title="移除" ng-click="picker.remove($index)">&times;</button>
                                </div>
                            </div>
                            <small class="text-danger d-block mt-1" ng-if="picker.error" ng-bind="picker.error"></small>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="defaultCheck1" ng-model="modal.anonymous">
                            <label class="form-check-label" for="defaultCheck1">
                                匿名
                            </label>
                        </div>
                        <div class="alert alert-warning py-2 mt-2 mb-0" ng-if="modal.anonymous && picker.items.length">
                            <strong>匿名提醒：</strong>系統會自動移除照片的拍攝資訊（GPS 位置、手機型號等），但請自行確認圖片內容（例如截圖中的姓名、帳號、Email）不會透露身分。
                        </div>
                        <div class="alert alert-danger py-2 mt-2 mb-0" ng-if="submitError" ng-bind="submitError"></div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" ng-click="createReply()" ng-disabled="submitting"><span ng-bind="submitting ? '發布中…' : '發布'"></span></button>
                </div>
            </div>
        </div>
    </div>



</div>


@section Scripts {
    <script>
        var postId = @ViewBag.id;
        var indexUrl = '@Url.Action("Index","Forum")';
    </script>
    <script src="~/Scripts/WebApp/Forum/ForumCtrl.js"></script>
    <script src="~/Scripts/moment-with-locales.js"></script>
    <!-- 警示彈跳視窗-->
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
}
