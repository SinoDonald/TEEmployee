            -webkit-margin-end: 0px;*/
            font-weight: bold;
        }

        /* ============================================================ */
        /* Post Index */
        /* ============================================================ */

        .post-list {
            /*   border-top: 6px solid #303030; */
            list-style: none;
            /*margin: 80px 40px 0;*/
            margin: 0 40px 0;
            /*            padding: 35px 0 0;*/
        }

        .post-stub {
            border-bottom: 1px dotted #303030;
            margin: 0;
        }

            .post-stub:first-child {
                padding-top: 0;
            }

            .post-stub a {
                -webkit-transition: all 0.2s ease-in-out;
                -moz-transition: all 0.2s ease-in-out;
                transition: all 0.2s ease-in-out;
                display: block;
                color: #424242;
                padding: 20px 5px;
            }

                .post-stub a:hover {
                    /*background: #F5F5FC;*/
                    color: #57A3E8;
                    padding: 20px 12px;
                    text-decoration: none;
                }

        .post-stub-title {
            display: inline-block;
            margin: 0;
            text-transform: none;
            /*width: 200px;*/
        }

        .post-stub-date {
            display: inline-block;
        }

        /* .post-stub-date:before {
                content: "/ ";
            }*/

        .next-posts-link a,
        .previous-posts-link a {
            display: block;
            padding: 8px 11px;
        }

        .btnSet {
            margin-top: 120px;
        }

        .show-content {
            margin: 0;
        }

        .post-name {
            position: relative;
            top: 15px;
        }

        .pagination {
            font-family: "Helvetica", Arial, sans-serif;
            /* Add other styling properties as needed */
        }

        /* ===== 附加圖片 (上傳) ===== */
        .forum-dropzone {
            border: 2px dashed #ced4da;
            border-radius: 8px;
            padding: 14px;
            text-align: center;
            color: #6c757d;
            background: #fafafa;
            transition: .15s;
        }
            .forum-dropzone.dragover {
                border-color: #007bff;
                background: #e9f2ff;
                color: #007bff;
            }
        .forum-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }
        .forum-preview-item {
            position: relative;
            width: 96px;
            height: 96px;
        }
            .forum-preview-item img {
                position: static;
                width: 96px;
                height: 96px;
                object-fit: cover;
                border-radius: 6px;
                border: 1px solid #dee2e6;
            }
            .forum-preview-item button {
                position: absolute;
                top: -8px;
                right: -8px;
                width: 22px;
                height: 22px;
                padding: 0;
                border: none;
                border-radius: 50%;
                background: #dc3545;
                color: #fff;
                font-size: 15px;
                line-height: 22px;
                cursor: pointer;
            }
        .forum-has-image {
            font-size: 1.1rem;
            vertical-align: -3px;
            color: #6c757d;
            margin-right: 4px;
        }
    </style>
}

<div ng-controller="IndexCtrl">

    <div id="post-index" class="container" style="display: block;">

        <div class="btnSet">
            <button type="button" ng-click="createModal()" class="btn btn-outline-secondary" data-toggle="modal" data-target="#exampleModal">

                <span class="material-icons" style="font-size:1rem">edit</span>
                新增貼文
            </button>
        </div>

        @*<div style="display: flex;">
            <div style="width: 65%;">
            </div>
            <div>
                最新回覆
            </div>
        </div>*@

        <ol class="post-list">

            <li class="post-stub" ng-repeat="item in posts | filter:filterPage(currentPage) | limitTo: pageSize">
                
                @*<a ng-href="~/Forum/Post/{{item.id}}">
                    <h4 class="post-stub-title" ng-bind="item.title" style="width: 600px"></h4>
                    <h4 class="post-stub-title post-name" ng-bind="item.name" style="width: 150px"></h4>
                    <time class="post-stub-date post-name" ng-bind="item.dateStr" style="width: 300px; white-space:pre"></time>
                    <h4 class="post-stub-title post-name" ng-bind="item.count" style="width: 50px"></h4>                    
                    <p class="show-content"><small ng-bind="item.content.substring(0, 20) + '...'">The content is licensed under a Creative Commons Attribution-ShareAlike 2.5 Generic License.</small></p>
                </a>*@
                
                <a ng-href="~/Forum/Post/{{item.id}}">
                    <h4 class="post-stub-title" style="width: 550px"><span class="material-icons forum-has-image" ng-if="item.imageCount > 0" title="有附圖">image</span><span ng-bind="item.title"></span></h4>
                    <h4 class="post-stub-title post-name" ng-bind="item.name" style="width: 100px"></h4>
                    @*<time class="post-stub-date post-name" ng-bind="item.postDate" style="width: 300px"></time>*@
                    <time class="post-stub-date post-name" ng-bind="item.dateStr" style="width: 200px; white-space:pre"></time>
                    <h4 class="post-stub-title post-name" ng-bind="item.count" style="width: 70px"></h4>
                    <h4 class="post-stub-title post-name" ng-bind="item.latestName" style="width: 100px"></h4>
                    <time class="post-stub-date post-name" ng-bind="item.latestDateStr" style="width: 150px; white-space:pre"></time>
                    <p class="show-content"><small ng-bind="item.content.substring(0, 20) + '...'">The content is licensed under a Creative Commons Attribution-ShareAlike 2.5 Generic License.</small></p>
                </a>
            </li>


            @*<li class="post-stub" ng-repeat="item in posts">
                    <a ng-href="~/Forum/Post/{{item.id}}">
                        <h4 class="post-stub-title" ng-bind="item.title"></h4>

                        <time class="post-stub-date" ng-bind="item.name"></time>

                    </a>
                </li>*@

            @*<li class="post-stub">
                    <a class="js-ajax-link" href="#">
                        <h4 class="post-stub-title">Introducing Ghostwriter</h4>

                        <time class="post-stub-date" datetime="Thu Sep 19 2013 11:58:31 GMT+0000 (UTC)">Published September 19th 2013</time>
                    </a>
                </li>*@

        </ol>

        <nav aria-label="Page navigation example" class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" aria-label="Previous" ng-click="switchPage(-1)">
                        <span aria-hidden="true">&laquo;</span>
                        <span class="sr-only">Previous</span>
                    </a>
                </li>
                <li ng-repeat="count in [-1,0,1]" class="page-item" ng-class="{'active':count === 0}"><a class="page-link" ng-hide="count + currentPage < 1 || count + currentPage > pageMax" ng-bind="count + currentPage" ng-click="switchPage(count)"></a></li>

                <li class="page-item">
                    <a class="page-link" aria-label="Next" ng-click="switchPage(1)">
                        <span aria-hidden="true">&raquo;</span>
                        <span class="sr-only">Next</span>
                    </a>
                </li>
            </ul>
        </nav>



        @*<nav aria-label="Page navigation example">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                            <span class="sr-only">Previous</span>
                        </a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                            <span class="sr-only">Next</span>
                        </a>
                    </li>
                </ul>
            </nav>*@

    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">新增貼文</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label for="exampleInputTitle">標題</label>
                            <input type="text" ng-model="modal.title" class="form-control" id="exampleInputTitle" placeholder="輸入標題" />
                        </div>
                        <div class="form-group">
                            <label for="exampleFormControlTextarea1">貼文內容</label>
                            <textarea ng-model="modal.content" class="form-control" id="exampleFormControlTextarea1" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label>附加圖片 <small class="text-muted">（選填，最多 5 張，JPG / PNG / GIF，單張 8 MB 以內）</small></label>
                            <div id="forumDropZone" class="forum-dropzone">
                                <span class="material-icons" style="vertical-align: middle">add_photo_alternate</span>
                                將圖片拖曳到這裡，或在此視窗按 <kbd>Ctrl</kbd> + <kbd>V</kbd> 貼上截圖
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('forumImageInput').click()">選擇圖片</button>
                                </div>
                                <input type="file" id="forumImageInput" accept="image/jpeg,image/png,image/gif" multiple hidden />
                            </div>
                            <div class="forum-preview" ng-if="picker.items.length">
                                <div class="forum-preview-item" ng-repeat="img in picker.items">
                                    <img ng-src="{{img.url}}" alt="預覽" />
                                    <button type="button" title="移除" ng-click="picker.remove($index)">&times;</button>
                                </div>
                            </div>
                            <small class="text-danger d-block mt-1" ng-if="picker.error" ng-bind="picker.error"></small>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="defaultCheck1" ng-model="modal.anonymous">
                            <label class="form-check-label" for="defaultCheck1">
                                匿名
                            </label>
                        </div>
                        <div class="alert alert-warning py-2 mt-2 mb-0" ng-if="modal.anonymous && picker.items.length">
                            <strong>匿名提醒：</strong>系統會自動移除照片的拍攝資訊（GPS 位置、手機型號等），但請自行確認圖片內容（例如截圖中的姓名、帳號、Email）不會透露身分。
                        </div>
                        <div class="alert alert-danger py-2 mt-2 mb-0" ng-if="submitError" ng-bind="submitError"></div>
                    </form>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" ng-click="createPost()" ng-disabled="submitting"><span ng-bind="submitting ? '發布中…' : '發布'"></span></button>
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    <script src="~/Scripts/WebApp/Forum/ForumCtrl.js"></script>
    <script src="~/Scripts/moment-with-locales.js"></script>
}